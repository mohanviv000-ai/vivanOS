{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/uv.sw.js",
      "destination": "/uv/uv.sw.js"
    },
    {
      "source": "/games/(.*)",
      "destination": "/games/$1"
    }
  ]
}

