{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/uv.sw.js",
      "destination": "/uv/uv.sw.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
